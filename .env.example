# Required only for the optional on-demand Hypixel profile lookup. Never commit
# a real token; the key must stay server-side and must not be sent to browsers.
HYPIXEL_API_KEY=

# Service and storage
HUNTLAB_HOST=127.0.0.1
HUNTLAB_PORT=8080
HUNTLAB_DATABASE=./huntlab.db
HUNTLAB_REFRESH_SECONDS=60

# No tax rate is assumed. Configure this for your in-game account/settings.
HUNTLAB_TAX_BASIS_POINTS=0
